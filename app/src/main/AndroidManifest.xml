<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- Internet & mạng -->
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />

    <application
        android:name=".MyApplication"
        android:allowBackup="true"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@mipmap/ic_launcher_round"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.MilkteaApp"
        >

        <activity
            android:name=".activity.EntryActivity"
            android:exported="true"
            android:theme="@style/Theme.MilkteaApp.Starting">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- Main/User -->
        <activity
            android:name=".activity.MainActivity"
            android:exported="false"
            android:launchMode="singleTask"
            android:theme="@style/Theme.MilkteaApp.NoActionBar" />

        <!-- Admin -->
        <activity
            android:name=".activity.admin.AdminMainActivity"
            android:exported="false"
            android:launchMode="singleTask"
            android:theme="@style/Theme.MilkteaApp.NoActionBar" />

        <!-- Auth -->
        <activity
            android:name=".activity.LoginActivity"
            android:exported="false"
            android:theme="@style/Theme.MilkteaApp.NoActionBar" />

        <activity
            android:name=".activity.RegisterActivity"
            android:exported="false"
            android:theme="@style/Theme.MilkteaApp.NoActionBar" />

        <activity
            android:name=".activity.ForgotPasswordActivity"
            android:exported="false"
            android:theme="@style/Theme.MilkteaApp.NoActionBar" />

        <activity
            android:name=".activity.admin.AdminOrderDetailActivity"
            android:exported="false"
            android:theme="@style/Theme.MilkteaApp.NoActionBar"/>

        <activity android:name=".activity.LoyaltyStatusActivity"
            android:exported="false"
            android:theme="@style/Theme.MilkteaApp.NoActionBar"/>

        <activity android:name=".activity.RedeemVoucherActivity"
            android:exported="false"
            android:theme="@style/Theme.MilkteaApp.NoActionBar"/>


        <!-- Admin product editor -->
        <activity
            android:name=".activity.admin.AdminProductEditorActivity"
            android:exported="false"
            android:theme="@style/Theme.MilkteaApp.NoActionBar" />

        <!-- Admin category editor -->
        <activity
            android:name=".activity.admin.CategoryEditorActivity"
            android:exported="false"
            android:theme="@style/Theme.MilkteaApp.NoActionBar" />

        <!-- Admin topping editor -->
        <activity
            android:name=".activity.admin.ToppingEditorActivity"
            android:exported="false"
            android:theme="@style/Theme.MilkteaApp.NoActionBar" />

        <!-- Admin combo editor -->
        <activity
            android:name=".activity.admin.AdminComboEditorActivity"
            android:exported="false"
            android:theme="@style/Theme.MilkteaApp.NoActionBar" />

        <!-- Admin voucher editor -->
        <activity
            android:name=".activity.admin.VoucherEditorActivity"
            android:exported="false"
            android:theme="@style/Theme.MilkteaApp.NoActionBar" />

        <!-- Admin user editor -->
        <activity
            android:name=".activity.admin.UserEditorActivity"
            android:exported="false"
            android:theme="@style/Theme.MilkteaApp.NoActionBar" />

        <!-- Admin Chat -->
        <activity
            android:name=".activity.admin.ChatActivity"
            android:exported="false"
            android:theme="@style/Theme.MilkteaApp.NoActionBar" />

        <!-- User Chat -->
        <activity
            android:name=".activity.UserChatActivity"
            android:exported="false"
            android:theme="@style/Theme.MilkteaApp.NoActionBar" />

        <!-- Cart & Checkout -->
        <activity
            android:name=".activity.CheckoutActivity"
            android:exported="false"
            android:theme="@style/Theme.MilkteaApp.NoActionBar" />

        <activity
            android:name=".activity.OrderHistoryActivity"
            android:exported="false"
            android:theme="@style/Theme.MilkteaApp.NoActionBar" />

        <activity
            android:name=".activity.OrderDetailActivity"
            android:exported="false"
            android:theme="@style/Theme.MilkteaApp.NoActionBar" />

        <!-- Profile & Settings -->
        <activity
            android:name=".activity.EditProfileActivity"
            android:exported="false"
            android:theme="@style/Theme.MilkteaApp.NoActionBar" />

        <activity
            android:name=".activity.ChangePasswordActivity"
            android:exported="false"
            android:theme="@style/Theme.MilkteaApp.NoActionBar" />

        <activity
            android:name=".activity.SettingsActivity"
            android:exported="false"
            android:theme="@style/Theme.MilkteaApp.NoActionBar" />
        <activity
            android:name=".activity.AddressActivity"
            android:exported="false"
            android:theme="@style/Theme.MilkteaApp.NoActionBar" />

    </application>
</manifest>
