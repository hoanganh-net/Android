<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/card"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="12dp"
    android:clickable="true"
    android:focusable="true"
    android:foreground="?attr/selectableItemBackground"
    app:cardCornerRadius="12dp"
    app:cardElevation="2dp"
    app:cardBackgroundColor="?attr/colorSurface">

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="10dp">

            <!-- Họ tên + SĐT -->
            <TextView
                android:id="@+id/tvNamePhone"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textStyle="bold"
                style="@style/TextAppearance.Material3.TitleSmall"
                android:textColor="?attr/colorOnSurface"
                tools:text="Nguyễn Văn A • 0901234567" />

            <!-- Địa chỉ gộp -->
            <TextView
                android:id="@+id/tvAddressLines"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                style="@style/TextAppearance.Material3.BodyMedium"
                tools:text="123 Nguyễn Trãi, P.1, Q.5, TP.HCM" />

            <!-- Hành động -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="end"
                android:layout_marginTop="6dp">

                <!-- Mặc định -->
                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnSetDefault"
                    style="@style/Widget.Material3.Button.OutlinedButton"
                    android:layout_width="wrap_content"
                    android:layout_height="36dp"
                    android:text="Mặc định"
                    android:textAllCaps="false"
                    android:textSize="13sp"
                    android:textColor="@color/black"
                    app:strokeColor="@color/gold"
                    app:icon="@drawable/ic_star_filled"
                    app:iconTint="@color/gold"
                    app:iconGravity="textStart"
                    app:iconPadding="6dp"
                    android:layout_marginEnd="6dp" />

                <!-- Sửa -->
                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnEdit"
                    android:layout_width="48dp"
                    android:layout_height="48dp"
                    android:insetTop="0dp"
                    android:insetBottom="0dp"
                    app:icon="@drawable/ic_edit"
                    app:iconTint="@color/white"
                    app:backgroundTint="@color/primary"
                    app:iconGravity="end"
                    android:layout_marginEnd="6dp"
                    style="@style/Widget.MaterialComponents.Button.Icon" />

                <!-- Xóa -->
                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnDelete"
                    android:layout_width="48dp"
                    android:layout_height="48dp"
                    android:insetTop="0dp"
                    android:insetBottom="0dp"
                    app:icon="@drawable/ic_delete"
                    app:iconTint="@color/white"
                    app:iconGravity="end"
                    app:backgroundTint="@color/error_red"
                    style="@style/Widget.MaterialComponents.Button.Icon" />
            </LinearLayout>
        </LinearLayout>

        <!-- Badge "Mặc định" ở góc trên bên phải -->
        <TextView
            android:id="@+id/tvDefaultBadge"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="top|end"
            android:layout_marginTop="8dp"
            android:layout_marginEnd="8dp"
            android:text="Mặc định"
            android:textColor="@color/black"
            android:textSize="10sp"
            android:visibility="gone"
            tools:visibility="visible" />
    </FrameLayout>
</com.google.android.material.card.MaterialCardView>
