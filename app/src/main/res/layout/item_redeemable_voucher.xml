<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginHorizontal="16dp"
    android:layout_marginTop="12dp"
    app:cardCornerRadius="12dp"
    app:cardElevation="2dp"
    app:cardBackgroundColor="@color/white"
    app:strokeWidth="1dp"
    app:strokeColor="@color/gray_300">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp">

        <!-- Header: Code + Points Required -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical">

            <TextView
                android:id="@+id/tvCode"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="TRASUA15K"
                android:textStyle="bold"
                android:textSize="18sp"
                android:textColor="@color/primary" />

            <TextView
                android:id="@+id/tvPointsRequired"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="100 điểm"
                android:textStyle="bold"
                android:textSize="14sp"
                android:textColor="@color/primary"
                android:background="@drawable/bg_tier_badge"
                android:paddingHorizontal="12dp"
                android:paddingVertical="6dp" />
        </LinearLayout>

        <!-- Benefit -->
        <TextView
            android:id="@+id/tvBenefit"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="Giảm 15.000đ"
            android:textSize="15sp"
            android:textColor="@color/black" />

        <!-- Description -->
        <TextView
            android:id="@+id/tvDescription"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:text="Mô tả voucher"
            android:textSize="13sp"
            android:textColor="@color/gray_600" />

        <!-- Min Order + Expiry -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:orientation="horizontal"
            android:weightSum="2">

            <TextView
                android:id="@+id/tvMinOrder"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="Đơn tối thiểu: 50.000đ"
                android:textSize="12sp"
                android:textColor="@color/gray_600" />

            <TextView
                android:id="@+id/tvExpiry"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="HSD: 31/12/2024"
                android:textSize="12sp"
                android:textColor="@color/gray_600"
                android:gravity="end" />
        </LinearLayout>

        <!-- Redeem Button -->
        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnRedeem"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:text="Đổi ngay"
            android:textAllCaps="false"
            android:backgroundTint="@color/primary"
            android:textColor="@color/white" />

    </LinearLayout>
</com.google.android.material.card.MaterialCardView>

