<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="vertical"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:padding="16dp">

    <!-- Date Picker Section -->
    <com.google.android.material.card.MaterialCardView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:cardCornerRadius="12dp"
        app:cardElevation="2dp"
        android:layout_marginBottom="16dp">

        <LinearLayout
            android:orientation="vertical"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:padding="16dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Chọn khoảng thời gian thống kê"
                android:textStyle="bold"
                android:textSize="16sp"
                android:textColor="@color/black"
                android:layout_marginBottom="12dp" />

            <!-- Calendar Range Picker Button -->
            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnSelectDateRange"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Chọn khoảng ngày"
                app:icon="@drawable/ic_calendar"
                app:iconGravity="start"
                android:layout_marginBottom="12dp"
                style="@style/Widget.MaterialComponents.Button.OutlinedButton" />

            <!-- Display selected date range -->
            <TextView
                android:id="@+id/tvSelectedDateRange"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Chưa chọn ngày"
                android:textSize="14sp"
                android:textColor="@color/gray_600"
                android:gravity="center"
                android:layout_marginBottom="12dp"
                android:padding="8dp" />

            <!-- Buttons -->
            <LinearLayout
                android:orientation="horizontal"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical">

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnLoadStatistics"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="Xem thống kê"
                    android:layout_marginEnd="8dp"
                    style="@style/Widget.MaterialComponents.Button" />
                
                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnToday"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Hôm nay"
                    style="@style/Widget.MaterialComponents.Button.OutlinedButton" />
            </LinearLayout>
        </LinearLayout>
    </com.google.android.material.card.MaterialCardView>

    <!-- KPI Grid for Advanced -->
    <GridLayout
        android:id="@+id/kpiGridAdvanced"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:columnCount="2"
        android:rowCount="2"
        android:useDefaultMargins="true">

        <include layout="@layout/view_stat_kpi" />

        <include layout="@layout/view_stat_kpi" />

        <include layout="@layout/view_stat_kpi" />

        <include layout="@layout/view_stat_kpi" />
    </GridLayout>

    <!-- Summary List -->
    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Tóm tắt thống kê"
        android:textStyle="bold"
        android:textSize="16sp"
        android:textColor="@color/black"
        android:layout_marginTop="16dp" />

    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/recyclerAdvanced"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:clipToPadding="false"
        android:paddingBottom="88dp" />
    
    <!-- Empty State for Advanced -->
    <LinearLayout
        android:id="@+id/emptyStateAdvanced"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center"
        android:orientation="vertical"
        android:visibility="gone"
        android:padding="24dp"
        android:layout_marginTop="16dp">
        
        <ImageView
            android:layout_width="80dp"
            android:layout_height="80dp"
            android:src="@drawable/ic_statistics"
            app:tint="@color/gray_400" />
        
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Chưa có dữ liệu cho khoảng thời gian này"
            android:textColor="@color/gray_600"
            android:textSize="16sp"
            android:textStyle="bold"
            android:layout_marginTop="12dp" />
        
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Vui lòng chọn khoảng thời gian khác hoặc thử lại sau"
            android:textColor="@color/gray_500"
            android:textSize="14sp"
            android:layout_marginTop="6dp" />
    </LinearLayout>
</LinearLayout>

